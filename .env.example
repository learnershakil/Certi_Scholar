# CertiScholar configuration. Create your .env with:  node scripts/init-env.mjs
# (it copies this file and fills every secret with a random value). Never commit .env.
#
# Values here are read by docker compose (api, worker, worker-ocr, web build) and validated by the API at
# startup: a missing or malformed value stops it with a message naming the variable.
# Tuning that administrators change day to day (confidence thresholds, tolerance, retention, verification
# provider, classification margin, age range) is NOT here: it lives in the database, on Admin → Settings.

# ── Environment ───────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                 # production enables hard guards: ClamAV + BullMQ required, no demo seed, no simulated provider

# ── Secrets (generated by init-env; at least 32 characters) ────────────────────────────────────────────
JWT_SECRET=                          # signs session tokens
PRESIGN_SECRET=                      # signs the short-lived document links
STORAGE_KEY=                         # 32 bytes, base64: AES-256-GCM key for documents at rest. Changing it makes stored files unreadable
STORAGE_KEY_ID=k1                    # bump when rotating; keep the old key readable during migration
REGISTRY_API_KEY=                    # only for the authorised-registry verification adapter

# ── Seed data (JSON files in apps/api/seed) ─────────────────────────────────────────────────────────────
SEED_DEMO=true                       # create the demo accounts from seed/demo-users.json (refused when NODE_ENV=production)
SEED_DEMO_PASSWORD=                  # password for those accounts (generated by init-env)
NEXT_PUBLIC_DEMO_ACCOUNTS=           # optional login-page shortcuts, e.g. student@certischolar.local:student,verifier@certischolar.local:verifier

# ── Sessions and links ─────────────────────────────────────────────────────────────────────────────────
SESSION_TTL_HOURS=8
PRESIGN_TTL_SECONDS=120

# ── Uploads ────────────────────────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── Background jobs ────────────────────────────────────────────────────────────────────────────────────
JOB_ATTEMPTS=3                       # tries per job before it is marked failed (and left retryable)
JOB_BACKOFF_MS=5000                  # first retry delay; doubles each time
OCR_CONCURRENCY=4                    # OCR jobs per worker-ocr container
WORKER_CONCURRENCY=8                 # jobs per container on the other queues
RETENTION_CRON="0 2 * * *"           # when the retention sweep runs (cron, server time)
OCR_TIMEOUT_MS=45000

# ── Lists ──────────────────────────────────────────────────────────────────────────────────────────────
LIST_PAGE_SIZE=200

# ── OCR service ────────────────────────────────────────────────────────────────────────────────────────
OCR_PROVIDER=tesseract               # or google_docai
OCR_WORKERS=2
GOOGLE_DOCAI_PROJECT=
GOOGLE_DOCAI_LOCATION=eu
GOOGLE_DOCAI_PROCESSOR=

OCR_SERVICE_TITLE=                   # title on the OCR service API docs (/docs)

# ── Document storage ──────────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=file                  # file = private Docker volume; r2 = Cloudflare R2 (run the migration first, see README)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                    # R2 API token's access key (scoped to the one bucket)
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=                         # optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
R2_KEY_PREFIX=documents/

# ── Profile matching (OCR'd details vs the applicant's profile) ─────────────────────────────────────────
PROFILE_MATCH_PROVIDER=basic         # groq = Groq LLM (needs GROQ_API_KEY); basic = exact rules, nothing leaves the server
GROQ_API_KEY=                        # from console.groq.com; only the compared values are sent, never the document image
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=15000
