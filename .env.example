# MongoDB
MONGO_URI=mongodb://localhost:27017/certischolar

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# API Server
PORT=3001
