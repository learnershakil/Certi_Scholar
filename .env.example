# JWT / Auth
JWT_SECRET=super_secret_for_local_dev_only

# Storage (e.g., Supabase / S3) - For local dev we might use a mock/local filesystem
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./.storage
