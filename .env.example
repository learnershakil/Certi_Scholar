# Copy to .env for docker compose. Generate real values for any shared environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NODE_ENV=development             # production enables hard guards (ClamAV required, BullMQ required, simulated provider blocked)
JWT_SECRET=                      # >= 32 chars
PRESIGN_SECRET=                  # >= 32 chars, signs short-lived document links
STORAGE_KEY=                     # 32 bytes, base64 (AES-256-GCM key for documents at rest)
STORAGE_KEY_ID=k1                # bump when rotating; keep old keys readable
PRESIGN_TTL_SECONDS=120
OCR_TIMEOUT_MS=45000
REGISTRY_API_KEY=                # only for the authorised-registry verification adapter

# OCR service
OCR_PROVIDER=tesseract           # or google_docai
GOOGLE_DOCAI_PROJECT=
GOOGLE_DOCAI_LOCATION=eu
GOOGLE_DOCAI_PROCESSOR=
