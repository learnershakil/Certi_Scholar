{
  "name": "@repo/module-classification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev-server.ts",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check-types": "tsc --noEmit",
    "corpus": "tsx test/corpus-report.ts",
    "enqueue": "tsx --env-file=.env src/scripts/enqueue.ts"
  },
  "dependencies": {
    "bullmq": "^5.0.0",
    "express": "^5.0.0",
    "ioredis": "^5.4.0",
    "mongoose": "^8.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.0",
    "@types/node": "26.4.1",
    "tsx": "^4.19.0",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  }
}
