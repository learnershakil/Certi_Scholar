[
  {
    "documentType": "marksheet",
    "format": "standard",
    "name": "State board statement of marks (printed total and percentage)",
    "version": 1,
    "fields": [
      {
        "key": "student_name",
        "label": "Candidate name",
        "kind": "text",
        "pattern": "Name of (?:the )?Candidate\\s*:?\\s*([A-Z][A-Za-z .']+?)\\s*$",
        "required": true
      },
      {
        "key": "roll_number",
        "label": "Roll number",
        "kind": "id",
        "pattern": "Roll\\s*(?:No\\.?|Number)\\s*:?\\s*([A-Z0-9]+)",
        "required": true
      },
      {
        "key": "board",
        "label": "Examining board",
        "kind": "text",
        "pattern": "^((?:[A-Z]+ )*BOARD(?: [A-Z]+)*)$",
        "required": false
      },
      {
        "key": "exam_year",
        "label": "Year of examination",
        "kind": "number",
        "pattern": "Year of Examination\\s*:?\\s*(\\d{4})",
        "required": true
      },
      {
        "key": "total_obtained",
        "label": "Total marks obtained",
        "kind": "number",
        "pattern": "Total Marks Obtained\\s*:?\\s*(\\d+)",
        "required": true
      },
      {
        "key": "total_max",
        "label": "Maximum total",
        "kind": "number",
        "pattern": "Total Marks Obtained\\s*:?\\s*\\d+\\s*/\\s*(\\d+)",
        "required": true
      },
      {
        "key": "percentage",
        "label": "Percentage (printed)",
        "kind": "number",
        "pattern": "Percentage\\s*:?\\s*(\\d{1,3}(?:\\.\\d+)?)",
        "required": true,
        "threshold": 0.9
      }
    ],
    "table": {
      "key": "subjects",
      "label": "Subject",
      "rowPattern": "^([A-Za-z][A-Za-z .&]+?)\\s+(\\d{2,3})\\s+(\\d{1,3})$",
      "columns": [
        {
          "key": "name",
          "kind": "text"
        },
        {
          "key": "max",
          "kind": "number"
        },
        {
          "key": "obtained",
          "kind": "number"
        }
      ]
    }
  },
  {
    "documentType": "marksheet",
    "format": "icse-class-x",
    "name": "ICSE Class X statement of marks (CISCE)",
    "version": 1,
    "fields": [
      {
        "key": "student_name",
        "label": "Candidate name",
        "kind": "text",
        "pattern": "^Name\\s*:?\\s*([A-Za-z.']{2,}(?:\\s+[A-Za-z.']{2,})*)",
        "required": true
      },
      {
        "key": "roll_number",
        "label": "Unique ID",
        "kind": "id",
        "pattern": "Unique\\s*ID\\s*:?\\s*(\\d{5,})",
        "required": true
      },
      {
        "key": "exam_year",
        "label": "Year of examination",
        "kind": "number",
        "pattern": "\\bYEAR\\s*:?\\s*(\\d{4})",
        "required": true
      },
      {
        "key": "board",
        "label": "Examining board",
        "kind": "text",
        "pattern": "^(COUNCIL FOR THE INDIAN SCHOOL CERTIFICATE EXAMINATIONS)",
        "required": false
      },
      {
        "key": "certificate_number",
        "label": "Certificate number",
        "kind": "id",
        "pattern": "^No\\.?\\s*([A-Z]{1,3}\\s?\\d{6,})",
        "required": false
      },
      {
        "key": "school",
        "label": "School",
        "kind": "text",
        "pattern": "^of\\s+([A-Za-z.',&]{2,}(?:\\s+[A-Za-z.',&]{2,})*)",
        "required": false
      },
      {
        "key": "result",
        "label": "Result",
        "kind": "text",
        "pattern": "RESULT\\W*(PASS|FAIL)",
        "required": false
      },
      {
        "key": "date_of_birth",
        "label": "Date of birth",
        "kind": "date",
        "pattern": "\\(in figures\\)\\s*(\\d{2}[./-]\\d{2}[./-]\\d{4})",
        "required": false
      }
    ],
    "table": {
      "key": "subjects",
      "label": "Subject",
      "rowPattern": "^([A-Za-z][A-Za-z ,.&]+?)\\s+(?:\\d{3}\\s+)?(\\d{1,3})\\s+((?:ZERO|NIL|ONE|TWO|THREE|FOUR|FIVE|SIX|SEVEN|EIGHT|NINE|HUNDRED)(?:\\s+(?:ZERO|NIL|ONE|TWO|THREE|FOUR|FIVE|SIX|SEVEN|EIGHT|NINE))*)$",
      "columns": [
        {
          "key": "name",
          "kind": "text"
        },
        {
          "key": "obtained",
          "kind": "number"
        },
        {
          "key": "words",
          "kind": "text"
        },
        {
          "key": "max",
          "kind": "number",
          "fixed": "100"
        }
      ]
    }
  },
  {
    "documentType": "income_certificate",
    "format": "standard",
    "name": "Tahsildar income certificate",
    "version": 1,
    "fields": [
      {
        "key": "certificate_number",
        "label": "Certificate number",
        "kind": "id",
        "pattern": "Certificate\\s*No\\.?\\s*:?\\s*([A-Z0-9/-]+)",
        "required": true
      },
      {
        "key": "holder_name",
        "label": "Name",
        "kind": "text",
        "pattern": "^Name\\s*:?\\s*([A-Z][A-Za-z .']+?)\\s*$",
        "required": true
      },
      {
        "key": "annual_income",
        "label": "Annual family income",
        "kind": "number",
        "pattern": "Annual (?:Family )?Income\\s*:?\\s*(?:Rs\\.?|₹)?\\s*([\\d,]+)",
        "required": true,
        "threshold": 0.9
      },
      {
        "key": "issue_date",
        "label": "Date of issue",
        "kind": "date",
        "pattern": "Date of Issue\\s*:?\\s*(\\d{2}[/-]\\d{2}[/-]\\d{4})",
        "required": true
      },
      {
        "key": "issuing_authority",
        "label": "Issuing authority",
        "kind": "text",
        "pattern": "Issuing Authority\\s*:?\\s*(.+)$",
        "required": false
      }
    ]
  },
  {
    "documentType": "identity",
    "format": "standard",
    "name": "Resident identity card",
    "version": 1,
    "fields": [
      {
        "key": "full_name",
        "label": "Full name",
        "kind": "text",
        "pattern": "^Name\\s*:?\\s*([A-Z][A-Za-z .']+?)\\s*$",
        "required": true
      },
      {
        "key": "date_of_birth",
        "label": "Date of birth",
        "kind": "date",
        "pattern": "(?:Date of Birth|DOB)\\s*:?\\s*(\\d{2}[/-]\\d{2}[/-]\\d{4})",
        "required": true
      },
      {
        "key": "id_number",
        "label": "ID number",
        "kind": "id",
        "pattern": "ID\\s*(?:Number|No\\.?)\\s*:?\\s*(\\d{4}\\s?\\d{4}\\s?\\d{4})",
        "required": true
      }
    ]
  }
]
